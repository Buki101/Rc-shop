<section class="wrap section"><span class="eyebrow orange">RC FIELD CLUB</span><h1 class="page-title">{{ collection.title | escape }}</h1><div class="rte">{{ collection.description }}</div>{% if collection == settings.parts_collection %}<form class="filter" data-parts-filter data-base="{{ collection.url }}"><label for="Model-{{ section.id }}">{{ 'ui.choose_model' | t }}</label><select id="Model-{{ section.id }}" name="model"><option value="">{{ 'ui.all_models' | t }}</option>{% for tag in collection.all_tags %}{% assign prefix = tag | slice: 0, 9 %}{% if prefix == 'rc-model-' %}<option value="{{ tag | handleize }}" {% if current_tags contains tag %}selected{% endif %}>{{ tag | remove_first: 'rc-model-' | replace: '-', ' ' | escape }}</option>{% endif %}{% endfor %}</select><button type="submit">{{ 'ui.show_parts' | t }}</button></form><p class="muted">{{ 'ui.fit_note' | t }}</p>{% endif %}<form method="get" class="filter"><label for="Sort">{{ 'ui.sort' | t }}</label><select id="Sort" name="sort_by">{% assign sort = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == sort %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select><button>{{ 'ui.apply' | t }}</button></form>{% paginate collection.products by 24 %}<div class="product-grid">{% for item in collection.products %}{% assign image_loading = 'lazy' %}{% if forloop.index <= 4 %}{% assign image_loading = 'eager' %}{% endif %}{% render 'product-card', item: item, loading: image_loading %}{% else %}<p>{{ 'ui.no_products' | t }}</p>{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</section>
{% schema %}
{"name": "Main Collection", "settings": []}
{% endschema %}
