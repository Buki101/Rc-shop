<section class="wrap section"><span class="eyebrow orange">RC FIELD CLUB</span><h1 class="page-title">{{ 'ui.garage' | t }}</h1><p>{{ 'ui.garage_intro' | t }}</p>{% if customer %}<p>{{ customer.first_name | escape }}</p><a class="text-link" href="{{ routes.account_url }}">{{ 'ui.manage_account' | t }} →</a>{% paginate customer.orders by 10 %}{% for order in customer.orders %}<section class="order"><h2>{{ order.name | escape }}</h2><p>{{ order.created_at | date: '%d %B %Y' }} · {{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</p>{% for line in order.line_items %}<article class="garage-line"><h3>{{ line.title | escape }}</h3>{% if line.product %}<a class="text-link" href="{{ line.product.url }}">{{ 'ui.view_model' | t }}</a>{% render 'parts-link', item: line.product %}{% else %}<p>{{ 'ui.unlisted' | t }}</p>{% endif %}</article>{% endfor %}</section>{% else %}<div class="empty"><h2>{{ 'ui.garage_empty' | t }}</h2><p>{{ 'ui.no_orders' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'ui.shop' | t }}</a></div>{% endfor %}{{ paginate | default_pagination }}{% endpaginate %}{% else %}<div class="empty"><h2>{{ 'ui.sign_in' | t }}</h2><p>{{ 'ui.sign_in_note' | t }}</p>{% if shop.customer_accounts_enabled %}<a class="button" href="{{ routes.storefront_login_url }}">{{ 'ui.sign_in' | t }}</a>{% else %}<p>{{ 'ui.accounts_soon' | t }}</p>{% endif %}</div>{% endif %}</section>
{% schema %}
{"name": "Garage", "settings": []}
{% endschema %}
