{% assign finder_url = routes.root_url | append: '#FindMyRC' %}
<section class="wrap hero"><div><span class="eyebrow orange">{{ section.settings.eyebrow | escape }}</span><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.text | escape }}</p><div class="actions"><a class="button" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button | escape }} <span aria-hidden="true">↗</span></a><a class="text-link" href="{{ section.settings.finder_link | default: finder_url }}">{{ 'ui.find' | t }} →</a></div></div><div class="hero-visual"><span class="eyebrow">{{ section.settings.caption | escape }}</span>{% assign featured = section.settings.product %}{% if section.settings.image %}{{ section.settings.image | image_url: width: 1400 | image_tag: widths: '480,720,960,1400', sizes: '(min-width: 800px) 48vw, 90vw', loading: 'eager', fetchpriority: 'high' }}{% elsif featured.featured_image %}{{ featured.featured_image | image_url: width: 1400 | image_tag: widths: '480,720,960,1400', sizes: '(min-width: 800px) 48vw, 90vw', loading: 'eager', fetchpriority: 'high' }}{% else %}<img src="{{ 'flight.svg' | asset_url }}" width="900" height="700" alt="" fetchpriority="high">{% endif %}{% if featured != blank %}<a class="hero-label" href="{{ featured.url }}"><h3>{{ featured.title | escape }}</h3><span>{{ featured.price | money_with_currency }} ↗</span></a>{% else %}<div class="hero-label"><h3>{{ 'ui.next_adventure' | t }}</h3><span aria-hidden="true">↗</span></div>{% endif %}</div></section>
{% schema %}
{"name": "Hero", "settings": [{"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "LESS SCROLLING. MORE FLYING."}, {"type": "text", "id": "heading", "label": "Heading", "default": "Small machines. Big adventures."}, {"type": "text", "id": "text", "label": "Description", "default": "From your first flight to your next off-road run. Find the RC that fits your kind of fun."}, {"type": "text", "id": "button", "label": "Button", "default": "Explore the range"}, {"type": "url", "id": "link", "label": "Button link"}, {"type": "url", "id": "finder_link", "label": "Finder page"}, {"type": "text", "id": "caption", "label": "Image caption", "default": "THE WEEKEND STARTS HERE"}, {"type": "product", "id": "product", "label": "Featured product"}, {"type": "image_picker", "id": "image", "label": "Hero image"}], "presets": [{"name": "Hero"}]}
{% endschema %}
