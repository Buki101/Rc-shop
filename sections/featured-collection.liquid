<section class="wrap section"><div class="section-title"><div><span class="eyebrow orange">{{ section.settings.eyebrow | escape }}</span><h2>{{ section.settings.heading | escape }}</h2></div>{% if section.settings.collection %}<a class="text-link" href="{{ section.settings.collection.url }}">{{ 'ui.view_all' | t }} →</a>{% endif %}</div><div class="product-grid">{% for item in section.settings.collection.products limit: 8 %}<div data-reveal>{% render 'product-card', item: item %}</div>{% else %}{% if request.design_mode %}<p>{{ 'ui.select_collection' | t }}</p>{% else %}<p>{{ 'ui.range_soon' | t }}</p>{% endif %}{% endfor %}</div></section>
{% schema %}
{"name": "Featured Collection", "settings": [{"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "YOUR NEXT GOOD DAY"}, {"type": "text", "id": "heading", "label": "Heading", "default": "Meet the line-up."}, {"type": "collection", "id": "collection", "label": "Collection"}], "presets": [{"name": "Featured Collection"}]}
{% endschema %}
