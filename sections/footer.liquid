<footer><div class="wrap footer-grid"><div><span class="eyebrow">RC FIELD CLUB</span><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p></div><nav aria-label="{{ 'ui.footer_nav' | t }}">{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</nav><div>{% form 'localization' %}{% if localization.available_countries.size > 1 %}<label for="Country">{{ 'ui.region' | t }}</label><select id="Country" name="country_code">{% for country in localization.available_countries %}<option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>{{ country.name | escape }} ({{ country.currency.iso_code }})</option>{% endfor %}</select><button type="submit">{{ 'ui.update' | t }}</button>{% endif %}{% endform %}<p class="muted">{{ localization.country.currency.iso_code }}</p></div></div><div class="wrap footer-bottom">© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</div></footer>
{% schema %}
{"name": "Footer", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "More outside. More good days."}, {"type": "text", "id": "text", "label": "Text", "default": "Find your next RC adventure. Keep it running with the right parts."}, {"type": "link_list", "id": "menu", "label": "Footer menu", "default": "footer"}]}
{% endschema %}
