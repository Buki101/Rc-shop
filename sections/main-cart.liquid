<section class="wrap section"><h1 class="page-title">{{ 'ui.your_bag' | t }}</h1>{% if cart.empty? %}<p>{{ 'ui.empty_bag' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'ui.shop' | t }}</a>{% else %}<form action="{{ routes.cart_url }}" method="post"><div class="cart-lines">{% for item in cart.items %}<article class="cart-line">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120,240', sizes: '120px' }}{% endif %}<div><h3><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h3><p>{{ item.variant.title | escape }}</p>{% for property in item.properties %}{% assign first_character = property.first | slice: 0 %}{% unless first_character == '_' %}{% if property.last != blank %}<p>{{ property.first | escape }}: {{ property.last | escape }}</p>{% endif %}{% endunless %}{% endfor %}{% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}{% for discount in item.line_level_discount_allocations %}<p>{{ discount.discount_application.title | escape }}: −{{ discount.amount | money }}</p>{% endfor %}<a class="text-link" href="{{ item.url_to_remove }}">{{ 'ui.remove' | t }}</a></div><div><label for="Qty-{{ forloop.index }}">{{ 'ui.quantity' | t }}</label><input id="Qty-{{ forloop.index }}" name="updates[]" type="number" min="0" step="1" value="{{ item.quantity }}" required><strong>{{ item.final_line_price | money_with_currency }}</strong></div></article>{% endfor %}</div><div class="cart-summary"><button name="update" type="submit">{{ 'ui.update_bag' | t }}</button>{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }}: −{{ discount.total_allocated_amount | money }}</p>{% endfor %}<h2>{{ 'ui.subtotal' | t }} {{ cart.total_price | money_with_currency }}</h2><p>{{ 'ui.checkout_costs' | t }}</p><button class="button" name="checkout" type="submit">{{ 'ui.checkout' | t }} →</button></div></form>{% endif %}</section>
{% schema %}
{"name": "Main Cart", "settings": []}
{% endschema %}
