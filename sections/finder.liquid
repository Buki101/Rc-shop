{% assign recommendation_count = 0 %}
{% for block in section.blocks %}
  {% if block.settings.product != blank %}
    {% assign recommendation_count = recommendation_count | plus: 1 %}
  {% endif %}
{% endfor %}
<section id="FindMyRC" class="wrap section" aria-labelledby="FinderTitle-{{ section.id }}"><span class="eyebrow orange">RC FIELD CLUB</span>{% if request.page_type == 'page' %}<h1 id="FinderTitle-{{ section.id }}" class="page-title">{{ 'ui.find' | t }}</h1>{% else %}<h2 id="FinderTitle-{{ section.id }}" class="page-title">{{ 'ui.find' | t }}</h2>{% endif %}<p>{{ 'ui.finder_intro' | t }}</p><form class="finder-form" data-finder><div class="finder-fields"><label>{{ 'ui.finder_category' | t }}<select name="category" required><option value="plane">{{ 'ui.choice_plane' | t }}</option><option value="car">{{ 'ui.choice_car' | t }}</option><option value="boat">{{ 'ui.choice_boat' | t }}</option><option value="helicopter">{{ 'ui.choice_helicopter' | t }}</option></select></label><label>{{ 'ui.finder_skill' | t }}<select name="skill" required><option value="0">{{ 'ui.choice_0' | t }}</option><option value="1">{{ 'ui.choice_1' | t }}</option><option value="2">{{ 'ui.choice_2' | t }}</option></select></label><label>{{ 'ui.finder_space' | t }}<select name="space" required><option value="field" data-categories="plane helicopter">{{ 'ui.choice_field' | t }}</option><option value="ground" data-categories="car">{{ 'ui.choice_ground' | t }}</option><option value="water" data-categories="boat">{{ 'ui.choice_water' | t }}</option><option value="hall" data-categories="plane car helicopter">{{ 'ui.choice_hall' | t }}</option></select></label><label>{{ 'ui.finder_goal' | t }}<select name="goal" required><option value="learn">{{ 'ui.choice_learn' | t }}</option><option value="cruise">{{ 'ui.choice_cruise' | t }}</option><option value="stunts">{{ 'ui.choice_stunts' | t }}</option><option value="offroad">{{ 'ui.choice_offroad' | t }}</option><option value="speed">{{ 'ui.choice_speed' | t }}</option><option value="hover">{{ 'ui.choice_hover' | t }}</option></select></label><label>{{ 'ui.budget' | t }} ({{ localization.country.currency.iso_code }})<input name="budget" type="number" min="1" step="0.01" value="250" required></label></div><p class="muted small">{{ 'ui.budget_note' | t }}</p><button class="button" type="submit"{% if recommendation_count == 0 %} disabled{% endif %}>{{ 'ui.show_matches' | t }} →</button>{% if recommendation_count > 0 %}<noscript><p>{{ 'ui.js_finder' | t }}</p></noscript>{% endif %}</form>{% if recommendation_count == 0 %}<div class="empty"><p>{{ 'ui.finder_coming_soon' | t }}</p><a class="text-link" href="{{ routes.all_products_collection_url }}">{{ 'ui.back_shop' | t }} →</a></div>{% endif %}<p data-finder-status role="status" aria-live="polite" data-prompt="{{ 'ui.finder_prompt' | t }}" data-match="{{ 'ui.match_status' | t }}" data-empty="{{ 'ui.no_match' | t }}"></p><div class="product-grid finder-results">{% for block in section.blocks %}{% assign item = block.settings.product %}{% if item != blank %}{% assign cheapest = item.variants | where: 'available', true | sort: 'price' | first %}<div data-finder-item data-category="{{ block.settings.category }}" data-skill="{{ block.settings.skill }}" data-space="{{ block.settings.space }}" data-goal="{{ block.settings.goal }}" data-price="{{ cheapest.price | default: 0 }}" data-available="{{ item.available }}" {{ block.shopify_attributes }}>{% render 'product-card', item: item %}<p class="match-note">{{ block.settings.reason | escape }}</p><p class="muted small">{{ block.settings.caution | escape }}</p></div>{% endif %}{% endfor %}</div></section>
{% schema %}
{"name": "Finder", "settings": [], "blocks": [{"type": "recommendation", "name": "RC recommendation", "settings": [{"type": "product", "id": "product", "label": "Product"}, {"type": "select", "id": "category", "label": "Category", "options": [{"value": "plane", "label": "Planes"}, {"value": "car", "label": "Cars"}, {"value": "boat", "label": "Boats"}, {"value": "helicopter", "label": "Helicopters"}], "default": "plane"}, {"type": "select", "id": "skill", "label": "Minimum experience", "options": [{"value": "0", "label": "Beginner with guidance"}, {"value": "1", "label": "Some experience"}, {"value": "2", "label": "Confident"}], "default": "0"}, {"type": "select", "id": "space", "label": "Suitable space", "options": [{"value": "field", "label": "Open flying field"}, {"value": "ground", "label": "Open outdoor ground"}, {"value": "water", "label": "Calm open water"}, {"value": "hall", "label": "Large clear indoor hall"}], "default": "field"}, {"type": "select", "id": "goal", "label": "Primary goal", "options": [{"value": "learn", "label": "Learn the basics"}, {"value": "cruise", "label": "Relaxed cruising"}, {"value": "stunts", "label": "Aerobatics"}, {"value": "offroad", "label": "Off-road driving"}, {"value": "speed", "label": "Speed"}, {"value": "hover", "label": "Hovering"}], "default": "learn"}, {"type": "text", "id": "reason", "label": "Why it fits", "default": "Add a verified reason this model fits these choices."}, {"type": "text", "id": "caution", "label": "Limitations and extras", "default": "Verify package contents and required extras before launch."}]}], "max_blocks": 30, "limit": 1, "presets": [{"name": "Finder"}]}
{% endschema %}
