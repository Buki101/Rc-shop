<section class="wrap section prose"><span class="eyebrow">{{ shop.name | escape }}</span><h1 class="page-title">{{ 'ui.opening' | t }}</h1><p>{{ shop.password_message | escape }}</p>{% form 'storefront_password' %}{{ form.errors | default_errors }}<label for="Password">{{ 'ui.password' | t }}</label><input id="Password" type="password" name="password" autocomplete="current-password" required><button class="button">{{ 'ui.enter' | t }}</button>{% endform %}</section>
{% schema %}
{"name": "Main Password", "settings": []}
{% endschema %}
