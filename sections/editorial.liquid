{% assign finder_url = routes.root_url | append: '#FindMyRC' %}
<section class="wrap section" data-reveal><div class="editorial"><div><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p><a class="button" href="{{ section.settings.link | default: finder_url }}">{{ section.settings.button | escape }} →</a></div><div class="editorial-list">{% for block in section.blocks %}<div {{ block.shopify_attributes }}><span>0{{ forloop.index }}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></div>{% endfor %}</div></div></section>
{% schema %}
{"name": "Editorial", "settings": [{"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A LITTLE GUIDANCE GOES A LONG WAY"}, {"type": "text", "id": "heading", "label": "Heading", "default": "Find your kind of fun."}, {"type": "text", "id": "text", "label": "Text", "default": "Tell us what you want to do, where you will use it and your budget. Explore a shortlist that fits."}, {"type": "text", "id": "button", "label": "Button", "default": "Find my RC"}, {"type": "url", "id": "link", "label": "Link"}], "blocks": [{"type": "point", "name": "Point", "settings": [{"type": "text", "id": "title", "label": "Title", "default": "Choose your adventure"}, {"type": "text", "id": "text", "label": "Text", "default": "Flying, driving or making waves."}]}], "max_blocks": 30, "presets": [{"name": "Editorial"}]}
{% endschema %}
