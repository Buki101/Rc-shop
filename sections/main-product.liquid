<section class="wrap section product-layout"><div class="gallery">{% for image in product.images %}{% if forloop.first %}{{ image | image_url: width: 1600 | image_tag: widths: '480,800,1200,1600', sizes: '(min-width: 800px) 55vw, 90vw', loading: 'eager', fetchpriority: 'high' }}{% else %}{{ image | image_url: width: 1200 | image_tag: widths: '480,800,1200', sizes: '(min-width: 800px) 55vw, 90vw', loading: 'lazy' }}{% endif %}{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}{% endfor %}</div><div><span class="eyebrow orange">{{ product.vendor | escape }}</span><h1 class="page-title">{{ product.title | escape }}</h1>{% assign selected = product.selected_or_first_available_variant %}<p class="price" data-product-price>{{ selected.price | money_with_currency }}</p><div class="rte">{{ product.description }}</div>{% form 'product', product %}<label for="Variant-{{ section.id }}">{{ 'ui.package' | t }}</label><select data-variant-select name="id" id="Variant-{{ section.id }}">{% for variant in product.variants %}<option data-available="{{ variant.available }}" data-price="{{ variant.price | money_with_currency | escape }}" value="{{ variant.id }}" {% if variant.id == selected.id %}selected{% endif %}>{{ variant.title | escape }} — {{ variant.price | money_with_currency }}{% unless variant.available %} — {{ 'ui.sold_out' | t }}{% endunless %}</option>{% endfor %}</select><label for="Quantity-{{ section.id }}">{{ 'ui.quantity' | t }}</label><input id="Quantity-{{ section.id }}" name="quantity" type="number" value="1" min="1" step="1" required><button data-add-button data-add-label="{{ 'ui.add' | t }}" data-sold-label="{{ 'ui.sold_out' | t }}" class="button wide" type="submit" {% unless selected.available %}disabled{% endunless %}>{% if selected.available %}{{ 'ui.add' | t }}{% else %}{{ 'ui.sold_out' | t }}{% endif %}</button>{{ form.errors | default_errors }}{% endform %}<p class="muted small">{{ 'ui.checkout_costs' | t }}</p>{% render 'parts-link', item: product %}{% for block in section.blocks %}{% case block.type %}{% when '@app' %}{% render block %}{% endcase %}{% endfor %}</div></section><script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{"name": "Main Product", "settings": [], "blocks": [{"type": "@app"}], "max_blocks": 30}
{% endschema %}
