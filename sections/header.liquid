{% if section.settings.announcement != blank %}<div class="announcement">{{ section.settings.announcement | escape }}</div>{% endif %}<header class="header"><div class="wrap nav"><a class="brand" href="{{ routes.root_url }}">{% if settings.logo %}{{ settings.logo | image_url: width: 360 | image_tag: widths: '180,360', loading: 'eager', class: 'logo' }}{% else %}<span class="brand-icon" aria-hidden="true">↗</span><span>RC FIELD<small>CLUB</small></span>{% endif %}</a><nav class="desktop" aria-label="{{ 'ui.main_nav' | t }}">{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% else %}<a href="{{ routes.all_products_collection_url }}">{{ 'ui.shop' | t }}</a>{% endfor %}</nav><div class="nav-actions"><a href="{{ routes.search_url }}">{{ 'ui.search' | t }}</a>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">{{ 'ui.account' | t }}</a>{% endif %}<a href="{{ routes.cart_url }}">{{ 'ui.bag' | t }} <span class="count">{{ cart.item_count }}</span></a></div><details class="mobile-menu"><summary>{{ 'ui.menu' | t }}</summary><nav>{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% else %}<a href="{{ routes.all_products_collection_url }}">{{ 'ui.shop' | t }}</a>{% endfor %}</nav></details></div></header>
{% schema %}
{"name": "Header", "settings": [{"type": "text", "id": "announcement", "label": "Announcement", "default": "A good day starts outdoors."}, {"type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu"}]}
{% endschema %}
