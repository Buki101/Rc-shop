<section class="wrap section"><h1 class="page-title">{{ 'ui.search' | t }}</h1><form action="{{ routes.search_url }}" method="get" role="search" class="filter"><label for="Search">{{ 'ui.search_products' | t }}</label><input id="Search" type="search" name="q" value="{{ search.terms | escape }}" required><input type="hidden" name="type" value="product"><button class="button">{{ 'ui.search' | t }}</button></form>{% if search.performed %}{% paginate search.results by 24 %}<div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', item: item, loading: 'eager' %}{% endif %}{% else %}<p>{{ 'ui.no_results' | t }}</p>{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}{% endif %}</section>
{% schema %}
{"name": "Main Search", "settings": []}
{% endschema %}
