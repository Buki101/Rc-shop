<!doctype html>
<html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="canonical" href="{{ canonical_url }}"><title>{{ page_title | escape }}{% unless page_title contains shop.name %} — {{ shop.name | escape }}{% endunless %}</title>{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}<meta name="theme-color" content="{{ settings.accent }}">
{{ 'theme.css' | asset_url | stylesheet_tag }}
{% style %}:root{--orange:{{ settings.accent }};--paper:{{ settings.background }};--ink:{{ settings.ink }}}{% endstyle %}
<script src="{{ 'theme.js' | asset_url }}" defer></script>{{ content_for_header }}</head><body>
<a class="skip" href="#MainContent">{{ 'ui.skip' | t }}</a>{% sections 'header-group' %}<main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>{% sections 'footer-group' %}</body></html>
